<template id="message-template-text">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble">
    <div class="px-3 py-2 whitespace-pre-wrap break-words" data-role="content"></div>
  </div>
</template>

<template id="message-template-voice">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble" data-role="voice-root">
    <div class="px-3 py-2 pr-14 flex flex-col gap-3 cursor-pointer" data-role="voice-container">
      <div class="flex items-center gap-2" data-role="voice-header">
        <img src="icon/voice.svg" width="18" height="18" class="tg-ui-icon" alt="voice icon">
        <span data-role="voice-label"></span>
      </div>
      <div class="flex items-center justify-center gap-2 text-xs text-gray-500"
           data-role="voice-controls">
        <div class="relative h-1 bg-gray-200 rounded overflow-hidden flex-1 cursor-pointer hidden" data-role="voice-progress" style="min-width: 120px;">
          <div class="absolute left-0 top-0 h-full w-0"
               data-role="voice-progress-inner"></div>
        </div>
        <button type="button" class="text-xs text-blue-500 leading-none"
                data-role="voice-speed">1.0x</button>
      </div>
    </div>
  </div>
</template>

<template id="message-template-voip">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble">
    <div class="flex items-center gap-3 px-4 py-3 pr-14">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/12 text-xs font-semibold text-emerald-600">
        通话
      </div>
      <div class="min-w-0">
        <div class="text-sm font-semibold text-slate-900" data-role="voip-title"></div>
        <div class="text-xs text-slate-500" data-role="voip-meta"></div>
      </div>
    </div>
  </div>
</template>

<template id="message-template-card">
  <div class="relative inline-block rounded-2xl shadow-lg w-1/2 bg-white text-gray-900 border border-gray-200 rounded-br-2xl rounded-tl-2xl rounded-bl-md message-bubble">
    <a class="block rounded-2xl overflow-hidden hover:bg-gray-50 transition" data-role="card-link" target="_blank" rel="noopener noreferrer">
      <div data-role="card-cover"></div>
      <div class="p-2">
        <h3 class="font-semibold text-sm text-gray-900 line-clamp-2" data-role="card-title"></h3>
        <p class="text-xs text-gray-500 mt-1 line-clamp-2" data-role="card-desc"></p>
        <div class="text-[10px] text-gray-400 mt-1" data-role="card-source"></div>
      </div>
    </a>
  </div>
</template>

<template id="message-template-video-account">
  <div class="relative inline-block max-w-[75%] overflow-hidden rounded-2xl border border-slate-200 bg-white text-gray-900 shadow-sm message-bubble">
    <a class="block transition hover:bg-slate-50" data-role="video-account-link" target="_blank" rel="noopener noreferrer">
      <div class="relative overflow-hidden bg-slate-100" data-role="video-account-cover-shell">
        <img data-role="video-account-cover" alt="视频号封面" class="hidden max-h-[320px] w-full object-cover" referrerpolicy="no-referrer">
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-black/45 text-lg text-white">▶</span>
        </div>
        <div class="absolute bottom-2 right-2 hidden rounded-full bg-black/65 px-2 py-1 text-[11px] text-white" data-role="video-account-duration"></div>
      </div>
      <div class="space-y-1 p-3">
        <div class="text-sm font-semibold text-slate-900" data-role="video-account-title"></div>
        <div class="line-clamp-3 text-sm text-slate-600" data-role="video-account-desc"></div>
        <div class="text-xs text-slate-400" data-role="video-account-source"></div>
      </div>
    </a>
  </div>
</template>

<template id="message-template-chat-history">
  <div class="relative inline-block max-w-[75%] overflow-hidden rounded-2xl border border-slate-200 bg-white text-gray-900 shadow-sm message-bubble">
    <button type="button" class="block w-full border-b border-slate-100 px-4 py-3 text-left hover:bg-slate-50" data-role="history-toggle">
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <div class="text-sm font-semibold text-slate-900 truncate" data-role="history-title"></div>
          <div class="mt-1 text-xs text-slate-500 whitespace-pre-wrap break-words" data-role="history-desc"></div>
        </div>
        <span class="text-xs text-slate-400" data-role="history-toggle-label">展开</span>
      </div>
    </button>
    <div class="hidden px-4 py-3" data-role="history-body">
      <div class="space-y-2" data-role="history-items"></div>
      <div class="mt-3 text-[11px] text-slate-400" data-role="history-footer"></div>
    </div>
  </div>
</template>

<template id="message-template-refer">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble" data-role="refer-root">
    <div class="mx-2.5 mt-2.5 rounded-xl border-l-4 border-blue-400/90 bg-blue-50/80 px-2.5 py-2 cursor-pointer flex flex-col gap-0.5" data-role="refer-quoted">
      <div class="text-[11px] leading-4 text-gray-500" data-role="refer-quoted-meta"></div>
      <div class="text-sm leading-5 text-gray-800 whitespace-pre-wrap break-words" data-role="refer-quoted-content"></div>
    </div>
    <div class="px-3 pb-2 pt-1 text-sm text-gray-900 whitespace-pre-wrap break-words" data-role="refer-body"></div>
  </div>
</template>

<template id="message-template-system-notice">
  <div class="mx-auto inline-flex max-w-[min(92%,40rem)] items-center justify-center rounded-full border border-slate-200/80 bg-white/92 px-4 py-2 text-center text-[13px] leading-5 text-slate-600 shadow-sm backdrop-blur-sm message-bubble" data-role="system-notice">
    <span class="whitespace-pre-wrap break-words" data-role="system-notice-content"></span>
  </div>
</template>

<template id="message-template-xml">
  <div class="p-3 relative inline-block max-w-[75%] rounded-2xl shadow-sm bg-white text-gray-900 border border-gray-200 message-bubble">
    <div class="px-3 py-2 pb-2 whitespace-pre-wrap break-words overflow-hidden" style="max-height: 6rem" data-role="xml-content"></div>
    <button class="mt-1 text-xs hover:underline ml-3" type="button" data-role="xml-toggle">展开</button>
  </div>
</template>

<template id="message-template-image">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble">
    <div class="relative overflow-hidden rounded-xl bg-slate-100 flex items-center justify-center" data-role="image-wrapper">
      <div class="py-6 px-4 text-xs text-slate-400" data-role="image-placeholder">图片加载中…</div>
      <img data-role="image" alt="图片消息" class="hidden max-w-full max-h-[360px] object-contain select-none" referrerpolicy="no-referrer">
    </div>
  </div>
</template>

<template id="message-template-video">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble">
    <div class="relative overflow-hidden rounded-xl bg-slate-900/80" data-role="video-thumbnail">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/80 text-slate-800 text-lg font-semibold">▶</span>
      </div>
      <div class="absolute bottom-2 right-2 text-xs text-white bg-black/50 px-2 py-1 rounded-full hidden" data-role="video-duration"></div>
    </div>
  </div>
</template>

<template id="message-template-file">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble bg-white border border-gray-200">
    <div class="flex items-center gap-3 p-3" data-role="file-body">
      <div class="h-12 w-12 flex items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-500 text-sm font-semibold" data-role="file-ext">FILE</div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold text-slate-800 truncate" data-role="file-title">文件</div>
        <div class="text-xs text-slate-400 mt-1" data-role="file-meta"></div>
      </div>
      <a data-role="file-download" class="text-sm text-blue-200 hover:text-blue-300 whitespace-nowrap" target="_blank" rel="noopener noreferrer">下载</a>
    </div>
  </div>
</template>

<template id="message-template-emoji">
  <div class="message-bubble inline-flex items-center justify-center rounded-2xl">
    <div class="inline-flex items-center justify-center" data-role="emoji-content">Emoji 替代符，TODO</div>
  </div>
</template>

<template id="message-template-fallback">
  <div class="relative inline-block max-w-[75%] rounded-2xl shadow-sm message-bubble">
    <div class="px-3 py-2 pr-14 pb-2 whitespace-pre-wrap break-words" data-role="content"></div>
  </div>
</template>
