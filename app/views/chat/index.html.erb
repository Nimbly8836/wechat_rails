<div class="chat-container" data-controller="chat">
  <!-- 左侧边栏 -->
  <div class="sidebar" style="position: relative;">
    <!-- 应用标题 -->
    <div class="header">
      <div class="app-name">
        <div class="">
          <img width="30" height="30" src="https://img.icons8.com/hands/50/sms.png" alt="sms"/>
        </div>
        Wechat
      </div>
    </div>

    <!-- 搜索栏 -->
    <input type="text" class="search-bar" placeholder="搜索联系人或搜索消息...">

    <!-- 标签栏 -->
    <div class="tab-bar">
      <div class="tab">消息</div>
      <div class="tab active">联系人</div>
    </div>

    <!-- 新增一个 list-area 包裹可滚动列表和字母导航 -->
    <div class="list-area">
      <div class="contacts-list"
           id="contacts-list"
           data-chat-target="contactsList"
           data-action="scroll->chat#highlightLetter">
        <div class="contacts-wrapper">
          <% @grouped_contacts.sort.each do |initial, contacts| %>
            <div class="contact-group"
                 id="group-<%= initial %>"
                 data-chat-target="group">
              <div class="group-header"><%= initial %></div>
              <% contacts.each do |contact| %>
                <div class="contact-item"
                     data-contact-id="<%= contact.id %>"
                     data-chat-target="contact"
                     data-action="click->chat#selectContact">
                  <div class="avatar">
                    <% if contact.avatar_url.present? %>
                      <%= image_tag contact.avatar_url, alt: contact.display_name %>
                    <% else %>
                      <div class="avatar-placeholder"><%= contact.display_name %></div>
                    <% end %>
                  </div>
                  <div class="contact-info">
                    <div class="contact-name"><%= contact.display_name %></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="letter-nav" aria-hidden="false">
        <% @letters.each do |letter| %>
          <div class="letter"
               data-letter="<%= letter %>"
               data-chat-target="letter"
               data-action="click->chat#scrollToGroup"><%= letter %></div>
        <% end %>
      </div>
    </div>
  </div>
  <!-- 右侧内容区 -->
  <div class="main-content">
    <div class="chat-box"
         id="chat-box"
         data-chat-target="chatBox">
      <div class="welcome-screen">
        <div class="welcome-title">欢迎使用聊天应用</div>
        <div class="welcome-subtitle">选择一个聊天来开始对话</div>
      </div>
    </div>
  </div>
</div>