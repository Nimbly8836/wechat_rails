<div class="flex flex-col h-full w-full bg-white rounded-lg shadow p-4"
     data-controller="chat-room"
     data-chat-room-current-wxid-value="<%= @chat_room.wx_id %>"
     data-chat-room-id-value="<%= @chat_room.id %>"
>
  <!-- 聊天头部 -->
  <div class="flex items-center mb-4 flex-shrink-0">
    <div class="w-10 h-10 rounded-full bg-gray-200 mr-3"></div>
    <div class="font-bold text-lg">聊天窗口</div>
  </div>

  <!-- 消息列表 -->
  <div class="flex-1 overflow-y-auto mb-4 flex flex-col gap-2 min-h-0"
       data-chat-room-target="messageList">
    <div class="text-gray-400 text-center py-8" data-chat-room-target="emptyMessage">暂无消息</div>
  </div>

  <!-- 输入区 - 固定在底部 -->
  <div class="flex items-center border-t pt-2 flex-shrink-0">
    <input type="text" class="flex-1 border rounded-full px-4 py-2 mr-2" placeholder="输入消息..."
           data-chat-room-target="input"/>
    <button class="bg-blue-500 text-white px-4 py-2 rounded-full"
            data-action="click->chat-room#sendMessage">发送
    </button>
  </div>
</div>
