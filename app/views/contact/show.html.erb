<h1>联系人信息</h1>

<p><strong>用户名:</strong> <%= @contact.user_name %></p>
<p><strong>昵称:</strong> <%= @contact.nick_name.presence || "未设置" %></p>
<p><strong>拼音首字母:</strong> <%= @contact.py_initial %></p>
