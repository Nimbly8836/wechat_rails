<div class="mx-auto flex h-full w-full max-w-4xl flex-col overflow-y-auto bg-gradient-to-b from-white via-slate-50 to-slate-100"
     data-controller="chat-bot code-editor"
     data-chat-bot-id-value="<%= @bot.persisted? ? @bot.id : "" %>">
  <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 px-4 py-4 backdrop-blur sm:hidden">
    <button type="button"
            class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50"
            data-action="click->chat-bot#openSidebar">
      <span aria-hidden="true">&larr;</span>
      <span>通讯录</span>
    </button>
    <div class="text-sm font-semibold text-slate-900">Bot 管理</div>
    <div class="w-16"></div>
  </div>

  <div class="px-5 py-6 sm:px-8">
    <div class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_55px_rgba(15,23,42,0.08)] ring-1 ring-slate-200/70">
      <div class="bg-[radial-gradient(circle_at_top,_rgba(124,58,237,0.16),_transparent_58%),linear-gradient(135deg,#f8fafc,#e9d5ff)] px-6 py-8 sm:px-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-[1.25rem] bg-violet-100 text-xl font-bold text-violet-700 shadow-sm">BOT</div>
            <h2 class="mt-4 text-2xl font-semibold text-slate-900" data-chat-bot-target="title">
              <%= @bot.name.presence || "新建 Bot" %>
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
              全局 Bot 可被加入不同聊天室，支持 beforeSend、afterSend 和 onMessage。
            </p>
          </div>
          <button type="button"
                  class="tg-secondary-action-button self-start"
                  data-action="click->chat-bot#newBot">
            新建 Bot
          </button>
        </div>
      </div>

      <div class="space-y-5 px-6 py-6 sm:px-10">
        <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
          <label class="block text-xs font-semibold uppercase tracking-wide text-slate-400">
            名称
            <input type="text"
                   value="<%= @bot.name %>"
                   class="mt-2 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-normal text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-300"
                   data-chat-bot-target="nameInput">
          </label>
          <label class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-700 sm:mt-6">
            <span>全局启用</span>
            <input type="checkbox"
                   class="h-4 w-4 rounded border-slate-300"
                   data-chat-bot-target="enabledInput"
                   <%= "checked" if @bot.enabled? %>>
          </label>
        </div>

        <label class="block text-xs font-semibold uppercase tracking-wide text-slate-400">
          超时毫秒
          <input type="number"
                 min="100"
                 max="5000"
                 step="100"
                 value="<%= @bot.timeout_ms || 1000 %>"
                 class="mt-2 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-normal text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-300"
                 data-chat-bot-target="timeoutInput">
        </label>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <label for="chat-bot-code" class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              JavaScript
            </label>
            <button type="button"
                    class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-violet-200 bg-violet-50 text-sm font-semibold text-violet-700 transition hover:bg-violet-100"
                    title="查看 Bot 示例和 action 说明"
                    aria-expanded="false"
                    data-action="click->chat-bot#toggleHelp">
              ?
            </button>
          </div>

          <div class="hidden rounded-2xl border border-violet-100 bg-violet-50/70 p-4 text-xs text-slate-600"
               data-chat-bot-target="helpPanel">
            <div class="flex flex-col gap-4">
              <div>
                <div class="font-semibold text-slate-800">可用 action</div>
                <div class="mt-2 grid gap-2 sm:grid-cols-2">
                  <div class="rounded-xl bg-white/80 p-3"><span class="font-mono font-semibold text-violet-700">allow</span>：beforeSend 使用，允许原消息继续发送。</div>
                  <div class="rounded-xl bg-white/80 p-3"><span class="font-mono font-semibold text-violet-700">modify</span>：beforeSend 使用，修改消息后发送，支持 <span class="font-mono">message.content</span>、<span class="font-mono">message.msg_type</span>、<span class="font-mono">message.extra</span>。</div>
                  <div class="rounded-xl bg-white/80 p-3"><span class="font-mono font-semibold text-violet-700">block</span>：beforeSend 使用，拦截本次发送，<span class="font-mono">message</span> 可作为提示文案。</div>
                  <div class="rounded-xl bg-white/80 p-3"><span class="font-mono font-semibold text-violet-700">reply</span>：onMessage 使用，让 Bot 回复消息，支持 <span class="font-mono">content</span> 或 <span class="font-mono">message.content</span>。</div>
                  <div class="rounded-xl bg-white/80 p-3"><span class="font-mono font-semibold text-violet-700">ignore</span>：onMessage 和 afterSend 使用，不做任何处理。</div>
                </div>
              </div>

              <div>
                <div class="font-semibold text-slate-800">运行时能力</div>
                <div class="mt-2 grid gap-2 sm:grid-cols-2">
                  <div class="rounded-xl bg-white/80 p-3">Bot 在服务端 Node 沙箱中执行，不能使用 <span class="font-mono">import</span>、<span class="font-mono">require</span> 或任意 npm 包。</div>
                  <div class="rounded-xl bg-white/80 p-3">可以使用平台提供的受限 <span class="font-mono">fetch</span> 调用外部 HTTP(S) API；会阻止 localhost、私网地址和危险协议。</div>
                </div>
              </div>

              <div>
                <div class="font-semibold text-slate-800">示例</div>
                <div class="mt-2 grid gap-3">
                  <div class="rounded-xl bg-slate-950 p-3 text-slate-100" data-chat-bot-example>
                    <div class="mb-2 flex items-center justify-between gap-2 text-slate-300">
                      <span>beforeSend：修改发送内容</span>
                      <button type="button" class="rounded-full bg-white/10 px-2 py-1 text-[11px] text-white transition hover:bg-white/20" data-action="click->chat-bot#copyExample">复制</button>
                    </div>
                    <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5"><code>module.exports.beforeSend = async function(ctx) {
  if (ctx.message.content === '/hook') {
    return {
      action: 'modify',
      message: { content: '/hook haha' }
    }
  }
  return { action: 'allow' }
}</code></pre>
                  </div>

                  <div class="rounded-xl bg-slate-950 p-3 text-slate-100" data-chat-bot-example>
                    <div class="mb-2 flex items-center justify-between gap-2 text-slate-300">
                      <span>beforeSend：拦截发送</span>
                      <button type="button" class="rounded-full bg-white/10 px-2 py-1 text-[11px] text-white transition hover:bg-white/20" data-action="click->chat-bot#copyExample">复制</button>
                    </div>
                    <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5"><code>module.exports.beforeSend = async function(ctx) {
  if (ctx.message.content.includes('禁止')) {
    return { action: 'block', message: '这条消息被 Bot 拦截' }
  }
  return { action: 'allow' }
}</code></pre>
                  </div>

                  <div class="rounded-xl bg-slate-950 p-3 text-slate-100" data-chat-bot-example>
                    <div class="mb-2 flex items-center justify-between gap-2 text-slate-300">
                      <span>onMessage：收到消息后回复</span>
                      <button type="button" class="rounded-full bg-white/10 px-2 py-1 text-[11px] text-white transition hover:bg-white/20" data-action="click->chat-bot#copyExample">复制</button>
                    </div>
                    <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5"><code>module.exports.onMessage = async function(ctx) {
  if (ctx.message.content === '/ping') {
    return { action: 'reply', content: '/pong' }
  }
  return { action: 'ignore' }
}</code></pre>
                  </div>

                  <div class="rounded-xl bg-slate-950 p-3 text-slate-100" data-chat-bot-example>
                    <div class="mb-2 flex items-center justify-between gap-2 text-slate-300">
                      <span>afterSend：发送后执行</span>
                      <button type="button" class="rounded-full bg-white/10 px-2 py-1 text-[11px] text-white transition hover:bg-white/20" data-action="click->chat-bot#copyExample">复制</button>
                    </div>
                    <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5"><code>module.exports.afterSend = async function(ctx) {
  console.log('sent', ctx.result?.success)
  return { action: 'ignore' }
}</code></pre>
                  </div>

                  <div class="rounded-xl bg-slate-950 p-3 text-slate-100" data-chat-bot-example>
                    <div class="mb-2 flex items-center justify-between gap-2 text-slate-300">
                      <span>fetch：调用外部 HTTP(S) API</span>
                      <button type="button" class="rounded-full bg-white/10 px-2 py-1 text-[11px] text-white transition hover:bg-white/20" data-action="click->chat-bot#copyExample">复制</button>
                    </div>
                    <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5"><code>module.exports.beforeSend = async function(ctx) {
  const response = await fetch('https://example.com/api', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ text: ctx.message.content })
  })
  const data = await response.json()

  return {
    action: 'modify',
    message: { content: data.content || ctx.message.content }
  }
}</code></pre>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="tg-code-editor-shell hidden" data-code-editor-target="mount"></div>
          <textarea id="chat-bot-code"
                    rows="18"
                    spellcheck="false"
                    class="w-full rounded-xl border border-slate-200 px-3 py-2 font-mono text-xs font-normal text-slate-700 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-300"
                    data-chat-bot-target="codeInput"
                    data-code-editor-target="textarea"><%= @bot.code %></textarea>
        </div>

        <div class="rounded-2xl bg-slate-50 px-4 py-3 text-xs text-slate-500" data-chat-bot-target="status">
          <% if @bot.last_error.present? %>
            最近错误：<%= @bot.last_error %>
            <% if @bot.last_error_at.present? %>
              （<%= l(@bot.last_error_at, format: :long) %>）
            <% end %>
          <% else %>
            Bot 会在服务端 Node 沙箱中执行；可使用受限 fetch，但不能 import/require npm 包。
          <% end %>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <button type="button"
                  class="text-sm text-rose-500 hover:text-rose-600 transition <%= "hidden" unless @bot.persisted? %>"
                  data-chat-bot-target="deleteButton"
                  data-action="click->chat-bot#deleteBot">
            删除 Bot
          </button>
          <div class="flex justify-end gap-2">
            <button type="button"
                    class="tg-secondary-action-button"
                    data-action="click->chat-bot#openSidebar">
              返回通讯录
            </button>
            <button type="button"
                    class="tg-primary-action-button"
                    data-action="click->chat-bot#save">
              保存 Bot
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
