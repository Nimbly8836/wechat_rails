<template id="emoji-select">
  <div class="emoji-panel hidden absolute bottom-full right-0 mb-3 border border-gray-200 bg-white shadow-xl rounded-2xl p-3 z-[140]"
       data-action="mouseenter->emoji#panelMouseenter mouseleave->emoji#panelMouseleave">
    <div class="emoji-panel-grid">
      <% Dir.glob(Rails.root.join("public/emoji/*.webp")).each do |path| %>
        <% filename = File.basename(path, ".webp") %>
        <% name = filename %>
        <button
          type="button"
          class="emoji-item flex items-center justify-center rounded-xl p-1 transition hover:bg-gray-100"
          data-emoji-name="<%= name %>"
          data-action="click->emoji#insert">
          <img src="/emoji/<%= filename %>.webp" alt="<%= name %>" class="h-full w-full object-contain"/>
        </button>
      <% end %>
    </div>
  </div>
</template>
