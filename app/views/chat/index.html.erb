<div class="tg-app-shell relative flex min-h-0 overflow-hidden" data-controller="chat">
  <button type="button"
          class="hidden fixed inset-0 z-30 bg-slate-950/35 backdrop-blur-[1px] sm:hidden"
          aria-label="关闭侧边栏"
          data-chat-target="overlay"
          data-action="click->chat#closeSidebar"></button>

  <button type="button"
          class="tg-desktop-sidebar-toggle hidden"
          aria-controls="sidebar"
          aria-label="打开侧边栏"
          title="打开侧边栏"
          data-chat-target="desktopSidebarToggle"
          data-action="click->chat#toggleDesktopSidebar">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <rect x="4" y="5" width="16" height="14" rx="3" stroke-width="1.8"/>
      <path d="M10 5v14" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>

  <div id="sidebar"
       class="fixed inset-y-0 left-0 z-40 flex w-[min(28rem,calc(100vw-1.25rem))] max-w-[560px] -translate-x-full overflow-hidden rounded-r-[2rem] shadow-2xl transition-transform duration-200 ease-out sm:static sm:z-auto sm:min-w-[360px] sm:translate-x-0 sm:rounded-none sm:shadow-none"
       data-chat-target="sidebar">
    <div class="tg-folder-rail">
      <div class="relative flex shrink-0 justify-center pb-3">
        <button type="button"
                class="tg-account-switcher-button"
                aria-label="切换账号"
                title="切换账号"
                data-chat-target="accountButton"
                data-action="click->chat#toggleAccountSwitcher">
          <span data-chat-target="accountAvatar">微</span>
        </button>
        <div class="tg-account-switcher-panel hidden" data-chat-target="accountPanel">
          <div class="px-3 py-2 text-xs font-semibold text-slate-500">切换账号</div>
          <div class="space-y-1" data-chat-target="accountList">
            <div class="px-3 py-3 text-xs text-slate-400">加载中...</div>
          </div>
        </div>
      </div>
      <div class="min-h-0 flex-1 overflow-hidden" data-chat-target="folderBar"></div>
      <div class="tg-global-theme-control">
        <button type="button"
                class="tg-global-theme-toggle"
                data-chat-target="globalThemeToggle"
                data-action="click->chat#toggleGlobalTheme"
                aria-label="切换全局日夜主题"
                aria-pressed="false"
                title="切换到黑夜模式">
          <span class="tg-global-theme-icon" data-chat-target="globalThemeIcon">☾</span>
          <span class="tg-global-theme-label" data-chat-target="globalThemeLabel"></span>
        </button>
      </div>
    </div>

    <div class="tg-sidebar-panel flex min-w-0 flex-1 flex-col">
      <div class="flex items-center gap-3 px-4 pb-3 pt-4">
        <label class="tg-search-shell flex-1">
          <img src="icon/search.svg" alt="" class="h-5 w-5 tg-ui-icon">
          <input type="text"
                 id="sidebar-search"
                 class="w-full bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none"
                 placeholder="搜索消息或者通讯录..."
                 data-action="keyup->chat#search">
        </label>
        <button type="button"
                class="flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 sm:hidden"
                aria-label="关闭侧边栏"
                data-action="click->chat#closeSidebar">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18 18 6M6 6l12 12"/>
          </svg>
        </button>
        <button type="button"
                class="tg-sidebar-collapse-button hidden sm:flex"
                aria-label="收起侧边栏"
                title="收起侧边栏"
                data-action="click->chat#toggleDesktopSidebar">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <rect x="4" y="5" width="16" height="14" rx="3" stroke-width="1.8"/>
            <path d="M10 5v14" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="relative min-h-0 flex-1 px-2 pb-2">
        <div id="message-list"
             class="h-full min-h-0 overflow-y-auto px-1 pb-2"
             data-chat-target="messagesList">
          <div id="chat-room-list"></div>
        </div>

        <div id="contacts-list"
             class="hidden h-full overflow-y-auto px-1 pb-2"
             data-chat-target="contactsList"
             data-action="scroll->chat#highlightLetter">
          <div class="space-y-3 px-1">
            <div class="flex items-center justify-end gap-2 px-1 text-xs">
              <button type="button"
                      class="rounded-full px-2 py-1 font-medium text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                      data-action="click->chat#expandAllContactGroups">
                展开全部
              </button>
              <button type="button"
                      class="rounded-full px-2 py-1 font-medium text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                      data-action="click->chat#collapseAllContactGroups">
                收起全部
              </button>
            </div>

            <div id="group-bots"
                 data-chat-target="group"
                 data-chat-collapsible-group
                 data-group-key="bots">
              <button type="button"
                      class="tg-contact-section-header"
                      data-chat-group-toggle
                      data-action="click->chat#toggleContactGroup"
                      data-chat-group-key-param="bots">
                <span class="flex items-center gap-3">
                  <span class="tg-contact-section-accent is-bot"></span>
                  <span>BOT</span>
                </span>
                <span class="flex items-center gap-2">
                  <span class="rounded-full bg-violet-100 px-2 py-0.5 text-xs text-violet-700" data-chat-target="botCount"><%= @chat_bots.size %></span>
                  <svg class="h-4 w-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-chat-group-chevron>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </button>
              <div class="space-y-1 pt-2" data-chat-group-body data-chat-target="botList">
                <% if @chat_bots.any? %>
                  <% @chat_bots.each do |bot| %>
                    <div class="tg-contact-row flex cursor-pointer items-center px-4 py-3 transition hover:bg-violet-50/70"
                         data-bot-id="<%= bot.id %>"
                         data-chat-target="bot"
                         data-action="click->chat#selectBot">
                      <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-[1rem] bg-violet-100 text-xs font-bold text-violet-700">BOT</div>
                      <div class="flex-1 overflow-hidden">
                        <div class="flex items-center gap-2">
                          <div class="truncate font-medium text-slate-900" data-chat-bot-name><%= bot.name.presence || "未命名 Bot" %></div>
                          <span class="tg-room-badge is-bot">BOT</span>
                        </div>
                        <div class="truncate text-xs text-slate-400" data-chat-bot-meta><%= bot.enabled? ? "全局启用" : "全局停用" %> · <%= bot.timeout_ms || 1000 %>ms</div>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <button type="button"
                          class="tg-contact-row flex w-full cursor-pointer items-center px-4 py-3 text-left transition hover:bg-violet-50/70"
                          data-action="click->chat#openNewBot">
                    <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-[1rem] bg-violet-100 text-lg font-bold text-violet-700">+</div>
                    <div class="min-w-0 flex-1">
                      <div class="font-medium text-slate-900">新建 Bot</div>
                      <div class="truncate text-xs text-slate-400">创建后可加入任意聊天室</div>
                    </div>
                  </button>
                <% end %>
              </div>
            </div>

            <% if @official_contacts.any? %>
              <div id="group-official-accounts"
                   data-chat-target="group"
                   data-chat-collapsible-group
                   data-group-key="official_accounts">
                <button type="button"
                        class="tg-contact-section-header"
                        data-chat-group-toggle
                        data-action="click->chat#toggleContactGroup"
                        data-chat-group-key-param="official_accounts">
                  <span class="flex items-center gap-3">
                    <span class="tg-contact-section-accent is-official"></span>
                    <span data-badge-kind="official">公众号</span>
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700"><%= @official_contacts.size %></span>
                    <svg class="h-4 w-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-chat-group-chevron>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </button>
                <div class="space-y-1 pt-2" data-chat-group-body>
                  <% @official_contacts.each do |contact| %>
                    <div class="tg-contact-row flex cursor-pointer items-center px-4 py-3 transition hover:bg-amber-50/70"
                         data-contact-id="<%= contact.id %>"
                         data-chat-target="contact"
                         data-action="click->chat#selectContact">
                      <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-[1rem] bg-amber-100 text-sm font-semibold text-amber-700">
                        <% if contact.avatar_url.present? %>
                          <%= image_tag contact.avatar_url, class: "w-full h-full object-cover", alt: contact.display_name %>
                        <% else %>
                          公
                        <% end %>
                      </div>
                      <div class="flex-1 overflow-hidden">
                        <div class="flex items-center gap-2">
                          <div class="truncate font-medium text-slate-900"><%= contact.display_name %></div>
                          <span class="tg-room-badge is-official" data-badge-kind="official">公众号</span>
                        </div>
                        <div class="truncate text-xs text-slate-400"><%= contact.user_name %></div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @group_chat_contacts.any? %>
              <div id="group-chatrooms"
                   data-chat-target="group"
                   data-chat-collapsible-group
                   data-group-key="group_chats">
                <button type="button"
                        class="tg-contact-section-header"
                        data-chat-group-toggle
                        data-action="click->chat#toggleContactGroup"
                        data-chat-group-key-param="group_chats">
                  <span class="flex items-center gap-3">
                    <span class="tg-contact-section-accent is-group"></span>
                    <span data-badge-kind="group">群聊</span>
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs text-sky-700"><%= @group_chat_contacts.size %></span>
                    <svg class="h-4 w-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-chat-group-chevron>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </button>
                <div class="space-y-1 pt-2" data-chat-group-body>
                  <% @group_chat_contacts.each do |contact| %>
                    <div class="tg-contact-row flex cursor-pointer items-center px-4 py-3 transition hover:bg-sky-50/70"
                         data-contact-id="<%= contact.id %>"
                         data-chat-target="contact"
                         data-action="click->chat#selectContact">
                      <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-[1rem] bg-sky-100 text-sm font-semibold text-sky-700">
                        <% if contact.avatar_url.present? %>
                          <%= image_tag contact.avatar_url, class: "w-full h-full object-cover", alt: contact.display_name %>
                        <% else %>
                          群
                        <% end %>
                      </div>
                      <div class="flex-1 overflow-hidden">
                        <div class="flex items-center gap-2">
                          <div class="truncate font-medium text-slate-900"><%= contact.display_name %></div>
                          <span class="tg-room-badge is-group" data-badge-kind="group">群聊</span>
                        </div>
                        <div class="truncate text-xs text-slate-400"><%= contact.user_name %></div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% @grouped_contacts.sort.each do |initial, contacts| %>
              <div id="group-<%= initial %>"
                   data-chat-target="group"
                   data-letter="<%= initial %>"
                   data-chat-collapsible-group
                   data-group-key="letter:<%= initial %>">
                <button type="button"
                        class="tg-contact-section-header is-letter"
                        data-chat-group-toggle
                        data-action="click->chat#toggleContactGroup"
                        data-chat-group-key-param="letter:<%= initial %>">
                  <span><%= initial %></span>
                  <span class="flex items-center gap-2">
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500"><%= contacts.size %></span>
                    <svg class="h-4 w-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-chat-group-chevron>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </button>
                <div class="space-y-1 pt-2" data-chat-group-body>
                  <% contacts.each do |contact| %>
                    <div class="tg-contact-row flex cursor-pointer items-center px-4 py-3 transition hover:bg-slate-50"
                         data-contact-id="<%= contact.id %>"
                         data-chat-target="contact"
                         data-action="click->chat#selectContact">
                      <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-[1rem] bg-slate-200 text-sm font-medium text-slate-600">
                        <% if contact.avatar_url.present? %>
                          <%= image_tag contact.avatar_url, class: "w-full h-full object-cover", alt: contact.display_name %>
                        <% else %>
                          <%= contact.display_name.to_s.first %>
                        <% end %>
                      </div>
                      <div class="flex-1 overflow-hidden">
                        <div class="truncate font-medium text-slate-900"><%= contact.display_name %></div>
                        <div class="truncate text-xs text-slate-400"><%= contact.user_name %></div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div id="settings-list"
             class="hidden h-full overflow-y-auto px-3 pb-3"
             data-chat-target="settingsList">
          <div class="space-y-4">
            <div class="tg-settings-card">
              <div class="text-sm font-semibold text-slate-900">分组管理</div>
              <div class="mt-1 text-xs text-slate-500">新建和删除分组统一放在这里，左侧只保留快捷入口。</div>
              <form class="mt-4 flex gap-2" data-action="submit->chat#createChatFolder">
                <input type="text"
                       class="tg-settings-input"
                       maxlength="24"
                       placeholder="新的分组名称"
                       data-chat-target="folderNameInput">
                <button type="submit" class="tg-primary-action-button shrink-0">新增</button>
              </form>
              <div class="mt-4 space-y-2" data-chat-target="folderSettingsList"></div>
            </div>

            <div class="tg-settings-card">
              <div class="text-sm font-semibold text-slate-900">通知设置</div>
              <div class="mt-1 text-xs text-slate-500" data-chat-target="notificationStatus"></div>
            </div>

            <label class="tg-settings-card flex items-start gap-3">
              <input type="checkbox"
                     class="mt-1 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                     data-chat-target="notificationToggle"
                     data-action="change->chat#updateNotificationsEnabled">
              <span>
                <span class="block font-medium text-slate-900">启用桌面通知</span>
                <span class="mt-1 block text-xs text-slate-500">收到新消息时允许浏览器弹出通知。</span>
              </span>
            </label>

            <label class="flex items-start gap-3 tg-settings-card">
              <input type="checkbox"
                     class="mt-1 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
                     data-chat-target="notificationHiddenOnly"
                     data-action="change->chat#updateNotificationsOnlyWhenHidden">
              <span>
                <span class="block font-medium text-slate-900">仅后台提醒</span>
                <span class="mt-1 block text-xs text-slate-500">页面前台打开时不弹出通知。</span>
              </span>
            </label>

            <div class="flex items-center gap-2">
              <button type="button"
                      class="tg-secondary-action-button"
                      data-action="click->chat#requestNotificationPermission">
                请求权限
              </button>
              <button type="button"
                      class="tg-primary-action-button"
                      data-action="click->chat#sendTestNotification">
                测试通知
              </button>
            </div>

            <div class="tg-settings-card">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <div class="text-sm font-semibold text-slate-900">聊天背景图片</div>
                  <div class="mt-1 text-xs text-slate-500">没有单独背景的聊天会使用这里的图片。</div>
                </div>
                <button type="button"
                        class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50"
                        data-action="click->chat#clearGlobalBackgroundImage">
                  清除
                </button>
              </div>
              <input type="url"
                     class="mt-4 tg-settings-input"
                     placeholder="输入图片链接，例如 https://example.com/bg.jpg"
                     data-chat-target="globalBackgroundImageInput"
                     data-action="input->chat#updateGlobalBackgroundImage">
            </div>

            <div class="tg-settings-card">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <div class="text-sm font-semibold text-slate-900">标签展示</div>
                  <div class="mt-1 text-xs text-slate-500">统一群聊和公众号标签样式，文案可直接修改，留空会回到默认值。</div>
                </div>
                <button type="button"
                        class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50"
                        data-action="click->chat#resetBadgeLabels">
                  恢复默认
                </button>
              </div>

              <div class="mt-4 space-y-3">
                <label class="block">
                  <span class="mb-1.5 block text-xs font-medium text-slate-600">群聊标签</span>
                  <input type="text"
                         class="tg-settings-input"
                         maxlength="12"
                         placeholder="群聊"
                         data-chat-target="groupBadgeInput"
                         data-action="input->chat#updateGroupBadgeLabel">
                </label>

                <label class="block">
                  <span class="mb-1.5 block text-xs font-medium text-slate-600">公众号标签</span>
                  <input type="text"
                         class="tg-settings-input"
                         maxlength="12"
                         placeholder="公众号"
                         data-chat-target="officialBadgeInput"
                         data-action="input->chat#updateOfficialBadgeLabel">
                </label>

                <div class="flex flex-wrap items-center gap-2 pt-1">
                  <span class="tg-room-badge is-group" data-badge-kind="group">群聊</span>
                  <span class="tg-room-badge is-official" data-badge-kind="official">公众号</span>
                </div>
              </div>
            </div>

            <div class="px-1 text-[11px] leading-5 text-slate-400">
              Icons by
              <a href="https://unicornicons.com/icons"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="font-medium text-slate-500 underline decoration-slate-300 underline-offset-2 hover:text-slate-700">
                Unicorn Icons
              </a>
            </div>
          </div>
        </div>

        <div class="absolute right-3 top-2 z-20 flex flex-col items-center justify-center gap-y-0.5 overflow-y-hidden rounded-2xl bg-white/90 px-1.5 py-2 shadow-lg antialiased sm:flex"
             id="letter-nav"
             data-chat-target="letterNav">
          <% @letters.each do |letter| %>
            <div class="letter cursor-pointer select-none rounded-lg px-1.5 py-0.5 text-[10px] font-semibold text-slate-500 hover:bg-slate-100"
                 data-letter="<%= letter %>"
                 data-chat-target="letter"
                 data-action="click->chat#scrollToGroup">
              <%= letter %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tg-section-switcher">
        <button type="button"
                class="tg-section-tab"
                data-chat-section-tab
                data-active="false"
                data-action="click->chat#switchTab"
                data-tab="contacts"
                aria-label="Contacts"
                title="Contacts">
          <img src="icon/user.svg" alt="" class="h-6 w-6 tg-ui-icon">
        </button>
        <button type="button"
                class="tg-section-tab"
                data-chat-section-tab
                data-active="true"
                data-action="click->chat#switchTab"
                data-tab="messages"
                aria-label="Messages"
                title="Messages">
          <img src="icon/message.svg" alt="" class="h-6 w-6 tg-ui-icon">
        </button>
        <button type="button"
                class="tg-section-tab"
                data-chat-section-tab
                data-active="false"
                data-action="click->chat#switchTab"
                data-tab="settings"
                aria-label="Settings"
                title="Settings">
          <img src="icon/settings.svg" alt="" class="h-6 w-6 tg-ui-icon">
        </button>
      </div>
    </div>
  </div>

  <div id="resizer"
       class="hidden cursor-col-resize touch-none sm:block sm:w-1"
       data-chat-target="resizer"
       data-action="mousedown->chat#startResize touchstart->chat#startResize">
  </div>

  <div class="tg-main-panel flex min-w-0 flex-1 flex-col overflow-hidden">
    <div class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/95 px-3 py-3 backdrop-blur sm:hidden"
         data-chat-target="mobileHeader">
      <button type="button"
              class="flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 text-slate-600 transition hover:bg-slate-50"
              aria-controls="sidebar"
              aria-label="打开侧边栏"
              data-chat-target="toggleButton"
              data-action="click->chat#toggleSidebar"></button>
      <div class="min-w-0">
        <div class="truncate text-sm font-semibold text-slate-900" data-chat-target="mobileTitle">消息</div>
      </div>
    </div>

    <div id="chat-box" class="relative h-full min-h-0 flex-1 overflow-hidden" data-chat-target="chatBox">
      <div class="tg-chat-empty-state flex h-full flex-col items-center justify-center px-6 text-center text-slate-500">
        <div class="tg-chat-empty-icon">聊</div>
        <div class="mt-5 text-lg font-semibold text-slate-800">选择一个会话开始聊天</div>
        <div class="mt-2 max-w-sm text-sm leading-6 text-slate-500">左侧会话、联系人和设置都已经收在同一个侧栏里，底部三个入口负责切换内容。</div>
      </div>
    </div>
