<div class="mx-auto flex h-full w-full max-w-3xl flex-col overflow-y-auto bg-gradient-to-b from-white via-slate-50 to-slate-100"
     data-controller="contact"
     data-contact-contact-value="<%= @contact.as_json(methods: [:official_account, :group_chat, :contact_kind]).to_json %>">
  <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 px-4 py-4 backdrop-blur sm:hidden">
    <button type="button"
            class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50"
            data-action="click->contact#openSidebar">
      <span aria-hidden="true">&larr;</span>
      <span>通讯录</span>
    </button>
    <div class="text-sm font-semibold text-slate-900">联系人详情</div>
    <div class="w-16"></div>
  </div>

  <div class="px-5 py-6 sm:px-8">
    <div class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_55px_rgba(15,23,42,0.08)] ring-1 ring-slate-200/70">
      <div class="bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.16),_transparent_58%),linear-gradient(135deg,#f8fafc,#e2e8f0)] px-6 py-8 text-center sm:px-10">
        <% if @contact.big_head_img_url.present? %>
          <img src="<%= @contact.big_head_img_url %>"
               alt="<%= @contact.nick_name %>"
               class="mx-auto h-24 w-24 rounded-[28px] border-4 border-white object-cover shadow-lg sm:h-28 sm:w-28"/>
        <% else %>
          <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-[28px] bg-slate-200 text-3xl font-bold text-slate-600 shadow-lg sm:h-28 sm:w-28">
            <%= @contact.nick_name.to_s.first || "?" %>
          </div>
        <% end %>

        <h2 class="mt-5 text-2xl font-semibold text-slate-900">
          <%= @contact.nick_name.presence || "未设置昵称" %>
        </h2>
        <% if @contact.official_account? %>
          <div class="mt-3">
            <span class="tg-room-badge is-official is-large" data-badge-kind="official">公众号</span>
          </div>
        <% elsif @contact.group_chat? %>
          <div class="mt-3">
            <span class="tg-room-badge is-group is-large" data-badge-kind="group">群聊</span>
          </div>
        <% end %>
        <p class="mt-2 text-sm text-slate-500">
          备注：<%= @contact.remark.presence || "未设置" %>
        </p>
        <p class="mt-1 text-sm text-slate-500">
          <%= [@contact.country, @contact.city].compact_blank.join(" ") %>
        </p>
        <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-slate-600">
          <%= @contact.signature.presence || "这个人很神秘，什么都没有写。" %>
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <button type="button"
                  data-action="click->contact#toChatRoom"
                  class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">
            发起聊天
          </button>
          <button type="button"
                  data-action="click->contact#toggleDetails"
                  class="inline-flex items-center justify-center rounded-full border border-slate-200 px-5 py-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50">
            查看更多 ▾
          </button>
        </div>
      </div>

      <div class="px-6 py-6 sm:px-10">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 px-4 py-4">
            <div class="text-xs uppercase tracking-[0.2em] text-slate-400">微信号</div>
            <div class="mt-2 break-all text-sm font-medium text-slate-900"><%= @contact.user_name %></div>
          </div>
          <div class="rounded-2xl bg-slate-50 px-4 py-4">
            <div class="text-xs uppercase tracking-[0.2em] text-slate-400">别名</div>
            <div class="mt-2 text-sm font-medium text-slate-900"><%= @contact.alias.presence || "未设置" %></div>
          </div>
        </div>

        <div data-contact-target="details" class="mt-6 hidden space-y-3 rounded-[24px] border border-slate-200 bg-white p-5 text-sm text-slate-700">
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
            <span class="text-slate-500">联系人 ID</span>
            <span class="font-medium text-slate-900"><%= @contact.id %></span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
            <span class="text-slate-500">拼音首字母</span>
            <span class="font-medium text-slate-900"><%= @contact.py_initial.presence || "-" %></span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
            <span class="text-slate-500">全拼</span>
            <span class="font-medium text-slate-900"><%= @contact.quan_pin.presence || "-" %></span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
            <span class="text-slate-500">性别</span>
            <span class="font-medium text-slate-900"><%= @contact.sex.presence || "-" %></span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
            <span class="text-slate-500">手机号</span>
            <span class="font-medium text-slate-900"><%= @contact.phone_num_list.presence || "-" %></span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-slate-500">标签</span>
            <span class="font-medium text-slate-900"><%= @contact.label_list.presence || "-" %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
