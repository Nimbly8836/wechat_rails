<div class="login-container">
  <%= turbo_frame_tag "qrcode_result" do %>

    <h2 class="login-header">
      <img class="login-img" src="https://img.icons8.com/hands/100/choose.png"
           alt="choose"/>
      选择协议
    </h2>

    <form action="/login" method="post" id="login-form" class="form-container">
      <select name="protocol" id="protocol" class="qrcode-image" required>
        <option value="" disabled selected>请选择</option>
        <% @protocol_options.each do |protocol, label| %>
          <option value="<%= protocol %>"><%= label %></option>
        <% end %>
      </select>

      <button type="submit" class="btn-primary">确定</button>
    </form>
  <% end %>

</div>